# The Cloud Run revision lego-tick-uat-00039-yip as deployed (non-secret settings from its YAML).
# Reproduce: python ops.py release-plan --env-file <this file> --account-id-stdin --enforce
# (any account id works; none is stored here). Expected: no BLOCK while the window is open.
WEBULL_ENV=UAT
LEGO_MODE=trade
LEGO_ACTIVE=true
LEGO_SYMBOL=UBER
LEGO_FIX_C=10000
LEGO_DIFF=25
LEGO_ALLOW_FRACTIONAL=true
LEGO_DNA_BUNDLE=strategy.uat-continuous.json
LEGO_DNA_CLOCK_MODE=market
LEGO_SESSION_KEY_MODE=market_day
LEGO_STALE_ORDER_ACTION=cancel
LEGO_STALE_ORDER_SECONDS=300
LEGO_CANCEL_CONFIRM_GRACE_SECONDS=120
LEGO_MAX_CANCEL_MUTATIONS_PER_ORDER=1
LEGO_MAX_ORDER_QUANTITY=30
LEGO_MAX_ORDER_NOTIONAL_USD=1500
LEGO_MAX_SESSION_ORDERS=26
LEGO_TRADING_WINDOW_END=2026-10-19T20:00:00Z
