# The Cloud Run revision lego-tick-uat-00037-led as deployed (non-secret settings from its YAML).
# Reproduce the verdict that stopped trading: python ops.py release-plan --env-file <this file> --account-id-stdin --enforce
# (any account id works; none is stored here). Expected: BLOCK window_open, WARN notional_cap_ratio and session_orders_cap.
WEBULL_ENV=UAT
LEGO_MODE=trade
LEGO_ACTIVE=true
LEGO_SYMBOL=UBER
LEGO_FIX_C=10000
LEGO_DIFF=25
LEGO_ALLOW_FRACTIONAL=true
LEGO_DNA_BUNDLE=strategy.example.json
LEGO_SESSION_KEY_MODE=market_day
LEGO_STALE_ORDER_ACTION=cancel
LEGO_STALE_ORDER_SECONDS=300
LEGO_CANCEL_CONFIRM_GRACE_SECONDS=120
LEGO_MAX_ORDER_QUANTITY=1000
LEGO_MAX_ORDER_NOTIONAL_USD=36000
LEGO_MAX_SESSION_ORDERS=30
LEGO_TRADING_WINDOW_END=2026-10-01T06:19:26Z
