# PRODUCTION real-money canary policy (docs/PROD_LIVE_RUNBOOK_TH.md). Every blank is a
# decision only the account owner can make: this file deliberately fills in none of the
# money values and none of the release values. Plan it with:
#   python ops.py release-plan --env-file deploy/prod-canary.env.example \
#       --window-sessions 5 --reference-price <price> --recommended-limits --enforce
# Add --initial-funding for the one-off funding release of a flat account (or buy the
# position yourself first: a single order of ~FIX_C is the largest risk of this system).
# The command prints the window end, caps, candidate hash, release authorization and the
# LEGO_PROD_LIVE_ACK to deploy with; never reuse an acknowledgement from another release.
WEBULL_ENV=PROD
LEGO_MODE=trade
LEGO_ACTIVE=true
LEGO_SYMBOL=
LEGO_FIX_C=
LEGO_DIFF=25
LEGO_DNA_BUNDLE=
# Start validation with whole shares; review any change explicitly.
LEGO_ALLOW_FRACTIONAL=false
LEGO_STALE_ORDER_ACTION=hold
LEGO_STALE_ORDER_SECONDS=300
LEGO_CANCEL_CONFIRM_GRACE_SECONDS=120
LEGO_MAX_CANCEL_MUTATIONS_PER_ORDER=1
LEGO_SESSION_KEY_MODE=market_day
# Production caps are never copied from UAT. A single order may not exceed 25% of
# FIX_C (release_horizon); a canary should be far tighter (10% or less).
LEGO_MAX_SESSION_ORDERS=
LEGO_MAX_ORDER_QUANTITY=
LEGO_MAX_ORDER_NOTIONAL_USD=
LEGO_TRADING_WINDOW_END=
LEGO_CANDIDATE_HASH=
LEGO_RELEASE_AUTHORIZATION=
# WEBULL_ACCOUNT_ID, app credentials and WEBULL_TOKEN_SECRET come from secrets. The
# token must be operator-issued, NORMAL and have more than 24 hours left.
