WEBULL_ENV=PROD
LEGO_MODE=observe
LEGO_ACTIVE=false
LEGO_SYMBOL=UBER
# Explicit production strategy settings; never import UAT monetary limits.
LEGO_FIX_C=
LEGO_DIFF=25
# LEAPS held as a stock replacement, in share-equivalents (1 contract = 100):
# counted with the real shares when rebalancing, never sold (a SELL is
# limited to the real shares). 0 = none; above 0 it is part of the release
# authorization (docs/LEAPS_STOCK_REPLACEMENT_TH.md).
LEGO_LEAPS=0
LEGO_DNA_BUNDLE=
LEGO_ALLOW_FRACTIONAL=true
LEGO_STALE_ORDER_ACTION=hold
LEGO_STALE_ORDER_SECONDS=300
LEGO_CANCEL_CONFIRM_GRACE_SECONDS=120
LEGO_MAX_CANCEL_MUTATIONS_PER_ORDER=1
LEGO_SESSION_KEY_MODE=market_day
LEGO_MAX_SESSION_ORDERS=
LEGO_MAX_SESSION_BUY_ORDERS=
LEGO_MAX_ORDER_QUANTITY=
LEGO_MAX_ORDER_NOTIONAL_USD=
LEGO_TRADING_WINDOW_END=
LEGO_RELEASE_AUTHORIZATION=
# WEBULL_TOKEN_SECRET must reference an enabled, hydrated operator-issued token.
