# Explicit UAT policy. Supply a NEW approval expiry and exact candidate/release.
WEBULL_ENV=UAT
LEGO_MODE=trade
LEGO_ACTIVE=true
LEGO_SYMBOL=UBER
LEGO_FIX_C=10000
LEGO_DIFF=25
LEGO_ALLOW_FRACTIONAL=true
LEGO_DNA_BUNDLE=strategy.example.json
LEGO_SLOT_SECONDS=900
LEGO_STALE_ORDER_ACTION=cancel
LEGO_STALE_ORDER_SECONDS=300
LEGO_CANCEL_CONFIRM_GRACE_SECONDS=120
LEGO_MAX_CANCEL_MUTATIONS_PER_ORDER=1
LEGO_SESSION_KEY_MODE=market_day
LEGO_MAX_SESSION_ORDERS=30
LEGO_MAX_ORDER_QUANTITY=1000
LEGO_MAX_ORDER_NOTIONAL_USD=36000
LEGO_TRADING_WINDOW_END=
LEGO_CANDIDATE_HASH=
LEGO_RELEASE_AUTHORIZATION=
# WEBULL_ACCOUNT_ID, app credentials and WEBULL_TOKEN_SECRET come from secrets.
