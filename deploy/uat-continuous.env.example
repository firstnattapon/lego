# Explicit UAT policy for continuous trading (docs/CONTINUOUS_RELEASE_V4_TH.md,
# docs/AUDIT_20261005_TH.md). The approval window, candidate and authorization are
# deliberately blank: nothing renews itself, and a stale value must never be reused.
#   python ops.py release-plan --env-file deploy/uat-continuous.env.example \
#       --window-sessions 10 --reference-price <last UBER price> --enforce
# prints the window end, candidate hash and release authorization to deploy with.
WEBULL_ENV=UAT
LEGO_MODE=trade
LEGO_ACTIVE=true
# The symbol is bound into the release authorization and is the account-symbol fence key
# (a new symbol is a new chain with its own halts and ledger). Change it here and in
# deploy/continuous-uat.sh together: test_deploy_scripts pins that the two agree.
LEGO_SYMBOL=UBER
LEGO_FIX_C=10000
LEGO_DIFF=25
LEGO_ALLOW_FRACTIONAL=true
# bypass:6500 = no DNA gate, ~11 months of market slots (ends 2027-09-07). Generated
# by tools/make_dna_bundle.py; a different bundle is a different chain.
LEGO_DNA_BUNDLE=strategy.uat-continuous.json
LEGO_SLOT_SECONDS=900
# cancel_expire = cancel + release a refused DAY order only on the expiry proof (UAT only);
# a PENDING / unfilled order the broker keeps listing is released 30 minutes after Place.
LEGO_STALE_ORDER_ACTION=cancel_expire
LEGO_STALE_ORDER_SECONDS=300
LEGO_CANCEL_CONFIRM_GRACE_SECONDS=120
LEGO_MAX_CANCEL_MUTATIONS_PER_ORDER=1
LEGO_SESSION_KEY_MODE=market_day
# Caps for FIX_C=10000 (15% of principal, ~1.3x that in shares, one order per slot).
# They must stay far below FIX_C: an order of FIX_C is what a mis-read position
# (holdings=0) would produce. A flat account needs the separate funding release.
# The 30-share cap is what release_horizon.recommend_limits gives for a reference price of
# 65 <= price < 78 USD (test_release_plan pins it); UBER traded at about 69 USD on 2026-10-20.
# For a symbol priced far from that band it is looser than the 1.3x rule, but the 1,500 USD
# notional cap still binds first. To tighten, plan with --recommended-limits --reference-price
# <last price> and deploy its caps.
# UBER again since 2026-10-22 (docs/AUDIT_20261022_TH.md): NFLX and MSFT are not tradable (OC)
# on UAT, and AAPL needs an initial-funding release (the account holds ~10 AAPL, not ~FIX_C).
LEGO_MAX_SESSION_ORDERS=26
LEGO_MAX_ORDER_QUANTITY=30
LEGO_MAX_ORDER_NOTIONAL_USD=1500
LEGO_TRADING_WINDOW_END=
LEGO_CANDIDATE_HASH=
LEGO_RELEASE_AUTHORIZATION=
# WEBULL_ACCOUNT_ID, app credentials and WEBULL_TOKEN_SECRET come from secrets.
